	(text "RTS=1,DTR=0 -> NRST=0 ; RTS=0,DTR=1 -> BOOT0=1 ; ca hai =1 hoac =0 -> khong tac dong"
		(exclude_from_sim no)
		(at 230 46 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "014e409f-d37f-46ec-9057-9ad39b2b1301")
	)
	(text "(RTS=1, DTR=0) → reset; (RTS=0, DTR=1) → nhả reset với BOOT0 = 1 → MCU vào bootloader. RTS,\nDTR cùng mức: không tác động."
		(exclude_from_sim no)
		(at 321.55 74.766 0)
		(effects
			(font
				(face "Arial")
				(size 1.25 1.25)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "07c4b148-56c3-453f-9548-8cc354ae8abe")
	)
	(text "Q302: RTS=0, DTR=1 → kéo BOOT_N xuống. R306 10k kéo BOOT_N lên khi nghỉ."
