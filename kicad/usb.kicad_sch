		(uuid "90208b33-4ceb-4024-ad5b-ca0dd8c20f49")
	)
	(text "(RTS=1, DTR=0) → reset; (RTS=0, DTR=1) → nhả reset với BOOT0 = 1 → MCU vào bootloader. RTS,\nDTR cùng mức: không tác động."
